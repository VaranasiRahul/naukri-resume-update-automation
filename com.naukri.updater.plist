<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <!-- Unique label for this LaunchAgent -->
    <key>Label</key>
    <string>com.naukri.updater</string>

    <!-- Python from the project's virtualenv + the script path -->
    <key>ProgramArguments</key>
    <array>
        <string>/Users/rvaranas/PROJECTS/naukri-A/Naukri/.venv/bin/python</string>
        <string>/Users/rvaranas/PROJECTS/naukri-A/Naukri/naukri.py</string>
    </array>

    <!-- Working directory so relative paths (naukri.log etc.) land in the project folder -->
    <key>WorkingDirectory</key>
    <string>/Users/rvaranas/PROJECTS/naukri-A/Naukri</string>

    <!-- Run at 9:03 AM and 2:03 PM every day.
         Combined with the 1-7 min random startup delay built into the script,
         actual execution lands between 9:04-9:10 AM and 2:04-2:10 PM,
         varying each day so Naukri never sees a fixed time pattern. -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>9</integer>
            <key>Minute</key>
            <integer>3</integer>
        </dict>
        <dict>
            <key>Hour</key>
            <integer>14</integer>
            <key>Minute</key>
            <integer>3</integer>
        </dict>
    </array>

    <!-- Redirect stdout and stderr to log files in the project folder -->
    <key>StandardOutPath</key>
    <string>/Users/rvaranas/PROJECTS/naukri-A/Naukri/naukri_launchd.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/rvaranas/PROJECTS/naukri-A/Naukri/naukri_launchd_error.log</string>

    <!-- Do NOT run immediately on load — only at scheduled times -->
    <key>RunAtLoad</key>
    <false/>
</dict>
</plist>
